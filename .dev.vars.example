# 本地开发用（wrangler dev 会读取 .dev.vars）。部署到生产请用 `wrangler secret put` + wrangler.toml 的 [vars]。
# 复制本文件为 .dev.vars 并填入真实值（不要提交 .dev.vars）。
# 本地把 Variables（明文）和 Secrets（密钥）合并在此一处；生产环境两者分离：
#   - Variables → 已写在 wrangler.toml [vars]（提交）
#   - Secrets   → 用 scripts/setup-secrets.sh / wrangler secret put（加密，不提交）
# 变量名与 E:/QinglongMy/.env 中的一致，可直接用 scripts/setup-secrets.sh 从本机 .env 导入敏感项。

# ---- WorkBuddy ----
WB_ACCESS_TOKEN=
WB_USER_ID=

# ---- Trae Work（TRAE_DEVICE_KEY_PEM / TRAE_DEVICE_PUB_PEM 为 base64 单行，同 .env）----
TRAE_TOKEN=
TRAE_DEVICE_ID=
TRAE_USER_ID=
TRAE_REFRESH_TOKEN=
TRAE_DEVICE_KEY_PEM=
TRAE_DEVICE_PUB_PEM=
TRAE_MACHINE_ID=
TRAE_APP_VERSION=1.107.1

# ---- MiniMax Code ----
MINIMAX_TOKEN=
MINIMAX_USER_ID=
MINIMAX_UUID=
MINIMAX_DEVICE_ID=

# ---- 美团 ----
MT_TOKEN=
MT_CLIENT_ID=
MT_AISCENE=

# ---- 通知（server酱 PUSH_KEY_MY 的值）----
NOTIFY_PUSH_KEY=

# ---- 手动触发保护（fetch ?key= 必须匹配；留空则任意请求都可触发）----
API_KEY=
