{
  "name": "qinglong-checkin",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker: 每日签到自动化（WorkBuddy / Trae / MiniMax / 美团），由 Cron Triggers 触发",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "dryrun": "wrangler deploy --dry-run --outdir dist",
    "test:crypto": "node --experimental-strip-types scripts/test-crypto.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.5.0",
    "wrangler": "^3.78.0"
  }
}
